{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/css/(.*)",
      "destination": "/backend/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/backend/frontend/js/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/backend/frontend/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/backend/frontend/$1"
    }
  ]
}
